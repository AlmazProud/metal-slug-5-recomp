// Windows executable resources: the manifest and the version information (no icons or game
// graphics).
#include <winver.h>
#include "version.h"

1 24 "port.manifest"

1 VERSIONINFO
FILEVERSION PORT_VERSION_MAJOR, PORT_VERSION_MINOR, PORT_VERSION_PATCH, 0
PRODUCTVERSION PORT_VERSION_MAJOR, PORT_VERSION_MINOR, PORT_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "metal-slug-5-recomp contributors"
            VALUE "FileDescription", "Metal Slug 5 native port (unofficial; bring your own copy)"
            VALUE "FileVersion", PORT_VERSION
            VALUE "InternalName", "mslug5"
            VALUE "LegalCopyright", "Port code: MIT License. Metal Slug 5 is (c) SNK; no game data included."
            VALUE "OriginalFilename", "mslug5.exe"
            VALUE "ProductName", "metal-slug-5-recomp"
            VALUE "ProductVersion", PORT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
